{
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(set)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(more *.env*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(gc *.env*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "model": "claude-opus-5-5",
  "agent": "agency-lead"
}
