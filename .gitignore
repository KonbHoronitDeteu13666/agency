# Данные клиентов и лидов — персональные данные, в git не кладём (структура остаётся через .gitkeep)
leads/*
clients/*
projects/*
brandbooks/*
!*/.gitkeep
.claude/settings.local.json
.env
design-library/inbox/*
!design-library/inbox/README.md
.playwright-mcp/

design-library/sources/*
!design-library/sources/.gitkeep
